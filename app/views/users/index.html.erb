<% @page_title = "ユーザ名簿" %>
<h1><%= @page_title %></h1>

<% if @users.present? %>
  <table class="list">
    <thead>
      <tr>
        <th>id</th>
        <th>ユーザー名</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td style="text-align: right"><%= user.id %></td>
          <td><%= link_to user.name, user %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%# <%= paginate @users %> %>
<% else %>
  <p>ユーザ情報がありません。</p>
<% end %>
