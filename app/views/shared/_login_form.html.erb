<h2>ログイン</h2>
<% if flash.alert %><p class="alert"><%= flash.alert %></p><% end %>
<%= form_tag :session, id: "login-form" do %>
  <form id="login-form">
    <div>
      <label>email：</label>
      <input type="text" name="email">
    </div>
    <div>
      <label>パスワード：</label>
      <input type="password" name="password">
    </div>
    <div>
      <input type="submit" value="ログイン">
    </div>
  </form>
<% end %>
