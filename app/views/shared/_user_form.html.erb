<% if controller.kind_of?(Admin::UsersController) %>
  <h2><%= @user.name %></h2>
  <table class="attr">
    <tr>
      <th><%= form.label :admin, "管理者" %></th>
      <td>
        <%= form.check_box :admin %>
      </td>
    </tr>
  </table>
<% else %>
  <table class="attr">
    <tr>
      <th><%= form.label :name, "氏名" %></th>
      <td><%= form.text_field :name %></td>
    </tr>
    <tr>
      <th>性別</th>
      <td>
        <%= form.radio_button :sex, 0 %>
        <%= form.label :sex_1, "男" %>
        <%= form.radio_button :sex, 1 %>
        <%= form.label :sex_2, "女" %>
      </td>
    </tr>
    <tr>
      <th><%= form.label :birthday, "誕生日",
                for: "member_birthday_1i" %></th>
      <td><%= form.date_select :birthday,
                start_year: 1940, end_year: Time.current.year,
                use_month_numbers: true %></td>
    </tr>
    <tr>
      <th><%= form.label :phone, "電話番号" %></th>
      <td><%= form.text_field :phone %></td>
    </tr>
    <tr>
      <th><%= form.label :email, "メールアドレス" %></th>
      <td><%= form.text_field :email %></td>
    </tr>
    <% if @user.new_record? %>
      <tr>
        <th><%= form.label :password, "パスワード" %></th>
        <td><%= form.text_field :password %></td>
      </tr>
    <% end %>
  </table>
<% end %>
