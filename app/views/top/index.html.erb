<h1>Nottekuレンタカー</h1>
<p>車を探す</p>
<%= form_tag :search_cars, method: :get, class: "search" do %>
  <table class="attr">
    <tr>
      <th>レンタル開始時刻</th>
      <td><%= datetime_select "rental_start", params[:rental_start] ,use_two_digit_numbers: true %></td>
    </tr>
    <tr>
      <th>レンタル終了時刻</th>
      <td><%= datetime_select "rental_end", params[:rental_end] ,use_two_digit_numbers: true %></td>
    </tr>
    <tr>
      <th>レンタル店舗</th>
      <td>
        <%= select_tag(
              :rental_store,
              options_for_select(
                Store.all.map{ |store| [store.name, store.id] } ,params[:rental_store]
              )
            )
        %>
      </td>
    </tr>
    <tr>
      <th>返却店舗</th>
      <td>
        <%= select_tag(
              :return_store,
              options_for_select(
                Store.all.map{ |store| [store.name, store.id] } ,params[:return_store]
              )
            )
        %>
      </td>
    </tr>
    <tr>
      <th>車種</th>
      <td>
        <%= select_tag(
              :car_type,
              options_for_select(
                ["乗用車", "軽自動車", "高級車", "ミニバン・ワゴン車", "トラック"]
              )
            )
        %>
      </td>
    </tr>
    <tr>
      <th>車名</th>
      <td><%= text_field_tag "name", params[:name] %></td>
    </tr>
    <tr>
      <th><%= submit_tag "検索" %></th>
    </tr>
  </table>
<% end %>
