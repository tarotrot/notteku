<% @page_title = "車一覧" %>
<h1><%= @page_title %></h1>
<%= link_to "新規車追加", :new_admin_car %>

<% if @cars.present? %>
  <table class="list">
    <thead>
      <tr>
        <th>id</th>
        <th>車名</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @cars.each do |car| %>
        <tr>
          <td style="text-align: right"><%= car.id %></td>
          <td><%= link_to car.name, [:admin, car] %></td>
          <td>
            <%= link_to "車情報変更", [:edit, :admin, car] %> |
            <%= link_to "削除", [:admin, car], method: :delete,
              data: { confirm: "本当に削除しますか?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @cars %>
<% else %>
  <p>車情報がありません。</p>
<% end %>
