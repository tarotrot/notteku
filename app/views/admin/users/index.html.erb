<% @page_title = "ユーザ一覧" %>
<h1><%= @page_title %></h1>

<% if @users.present? %>
  <table class="list">
    <thead>
      <tr>
        <th>id</th>
        <th>氏名</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td style="text-align: right"><%= user.id %></td>
          <td><%= link_to user.name, [:admin, user] %></td>
          <td>
            <%= link_to "管理者権限変更", [:edit, :admin, user] %> |
            <%= link_to "削除", [:admin, user], method: :delete,
              data: { confirm: "本当に削除しますか?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%# <%= paginate @users %> %>
<% else %>
  <p>ユーザ情報がありません。</p>
<% end %>
