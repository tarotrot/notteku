<% @page_title = "予約一覧" %>
<h1><%= @page_title %></h1>

<% if @bookings.present? %>
  <table class="list">
    <thead>
      <tr>
        <th>予約コード</th>
        <th>予約者名</th>
        <th>予約車</th>
        <th>レンタル開始時刻</th>
        <th>レンタル終了時刻</th>
        <th>状態</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @bookings.each do |booking| %>
        <tr>
          <td style="text-align: right"><%= link_to booking.booking_code , [:admin, booking]%></td>
          <td><%= link_to booking.user.name, [:admin, booking.user] %></td>
          <td><%= link_to booking.car.name, [:admin, booking.car] %></td>
          <td><%= booking.rental_start&.strftime("%Y/%m/%d %H:%M") %></td>
          <td><%= booking.rental_end&.strftime("%Y/%m/%d %H:%M") %></td>
          <td><%= booking.status%></td>
          <td>
            <%= link_to "予約状況変更", [:edit, :admin, booking] %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%# <%= paginate @users %> %>
<% else %>
  <p>予約情報がありません。</p>
<% end %>
<%#
t.string :booking_code, null: false                                                     # 予約コード
t.references :rental_store, null: false, foreign_key: {to_table: :stores}               # レンタル店舗
t.references :return_store, null: false, foreign_key: {to_table: :stores}               # 返却店舗
t.references :car, null: false                                                          # 車
t.references :user, null: false                                                         # ユーザ
t.datetime :rental_start, null: false                                                   # レンタル開始時刻
t.datetime :rental_end, null: false                                                     # レンタル終了時刻
t.integer :total_price, null: false                                                     # 合計金額
t.string :status, null: false                                                           # 予約状態 %>
