<% @page_title = "予約一覧" %>
<h1><%= current_user.name + "さんの" + @page_title %></h1>

<% if @bookings.present? %>
  <table class="list">
    <thead>
      <tr>
        <th>予約コード</th>
        <th>予約車</th>
        <th>レンタル開始時刻</th>
        <th>レンタル終了時刻</th>
        <th>状態</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @bookings.each do |booking| %>
        <tr>
          <td style="text-align: right"><%= link_to booking.booking_code, booking%></td>
          <td><%= booking.car.name %></td>
          <td><%= booking.rental_start&.strftime("%Y/%m/%d %H:%M") %></td>
          <td><%= booking.rental_end&.strftime("%Y/%m/%d %H:%M") %></td>
          <td><%= booking.status%></td>
          <td>
            <%= link_to "予約状況変更", [:edit, booking] %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%# <%= paginate @users %> %>
<% else %>
  <p>予約情報がありません。</p>
<% end %>
<%= current_user.id %>
